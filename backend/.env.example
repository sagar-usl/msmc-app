NODE_ENV=development
PORT=4000

DATABASE_URL=postgres://localhost:5432/msmc

JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

OTP_TTL_SEC=300
OTP_MAX_ATTEMPTS=5

# Dev-only: lets the logged-in test account flip citizen <-> officer role
# via POST /auth/dev/become-officer. Must be false/unset outside development.
ALLOW_DEV_ROLE_SWITCH=true

UPLOAD_DIR=uploads
